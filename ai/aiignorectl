#!/usr/bin/env bash
set -euo pipefail

# ===================================
# METADATA
# ===================================
SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly VERSION="1.0.0"

# ===================================
# COLORS
# ===================================
if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
	readonly RED=$'\033[0;31m'
	readonly GREEN=$'\033[0;32m'
	readonly YELLOW=$'\033[0;33m'
	readonly BLUE=$'\033[0;34m'
	readonly MAGENTA=$'\033[0;35m'
	readonly BOLD=$'\033[1m'
	readonly NC=$'\033[0m'
else
	readonly RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' BOLD='' NC=''
fi

# ===================================
# CONFIGURATION
# ===================================
DEBUG=false
QUIET=false

readonly AI_PATHS=(
	.claude
	CLAUDE.md
	CLAUDE.local.md
	.mcp.json
	.mcp-memory
	AGENTS.md
	GEMINI.md
	.cursor
	.cursorrules
	.windsurfrules
)

readonly BLOCK_BEGIN="# >>> aiignorectl >>>"
readonly BLOCK_END="# <<< aiignorectl <<<"
readonly LEGACY_BLOCK_BEGIN="# >>> local-ignore-ai-config >>>"
readonly LEGACY_BLOCK_END="# <<< local-ignore-ai-config <<<"

EXCLUDE_FILE=""

# ===================================
# LOGGING FUNCTIONS
# ===================================
log() {
	[[ "$QUIET" != true ]] || return 0
	printf "${BLUE}▶${NC} %s\n" "$*"
}
warn() { printf "${YELLOW}⚠${NC} %s\n" "$*" >&2; }
error() { printf "${RED}✗${NC} %s\n" "$*" >&2; }
success() {
	[[ "$QUIET" != true ]] || return 0
	printf "${GREEN}✓${NC} %s\n" "$*"
}
debug() {
	[[ "$DEBUG" == true ]] || return 0
	printf "${MAGENTA}⚈${NC} DEBUG: %s\n" "$*" >&2
}
die() {
	error "$*"
	exit 1
}

# ===================================
# UTILITIES
# ===================================
require_command() {
	command -v "$1" >/dev/null 2>&1 || die "'$1' is not installed or not in PATH."
}

setup_repository() {
	require_command git
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not inside a git repository."
	cd "$(git rev-parse --show-toplevel)"
	EXCLUDE_FILE="$(git rev-parse --git-path info/exclude)"
	mkdir -p "$(dirname "$EXCLUDE_FILE")"
	touch "$EXCLUDE_FILE"
	debug "Exclude file: $EXCLUDE_FILE"
}

list_tracked_paths() {
	git ls-files -z -- "${AI_PATHS[@]}"
}

strip_block() {
	local begin="$1" end="$2" tmp
	tmp="$(mktemp)"
	awk -v b="$begin" -v e="$end" '
		$0 == b { skip = 1; next }
		$0 == e { skip = 0; next }
		!skip { print }
	' "$EXCLUDE_FILE" >"$tmp"
	cat "$tmp" >"$EXCLUDE_FILE"
	rm -f "$tmp"
}

remove_exclude_blocks() {
	strip_block "$BLOCK_BEGIN" "$BLOCK_END"
	strip_block "$LEGACY_BLOCK_BEGIN" "$LEGACY_BLOCK_END"
}

# ===================================
# COMMANDS
# ===================================
cmd_help() {
	cat <<EOF
${BOLD}${SCRIPT_NAME}${NC} - Keep personal AI tooling config local-only in a repo that tracks other contributors' versions

${BOLD}USAGE:${NC}
  $SCRIPT_NAME [OPTIONS] COMMAND

${BOLD}COMMANDS:${NC}
  ${GREEN}hide${NC}               Exclude AI config paths and hide tracked ones from git status
  ${GREEN}unhide${NC}             Remove the exclude block and restore normal tracking
  ${GREEN}status${NC}             Show the exclude block and hidden tracked files
  ${GREEN}help${NC}               Show this help message
  ${GREEN}version${NC}            Show script version

${BOLD}OPTIONS:${NC}
  ${YELLOW}-q, --quiet${NC}                  Minimize output
  ${YELLOW}-d, --debug${NC}                  Enable debug output
  ${YELLOW}-h, --help${NC}                   Show help
  ${YELLOW}-v, --version${NC}                Show version

${BOLD}NOTES:${NC}
  Run inside the target repository. Untracked paths are excluded through
  .git/info/exclude; tracked ones are flagged skip-worktree and
  assume-unchanged (the latter survives sparse-checkout).

${BOLD}EXAMPLES:${NC}
  $SCRIPT_NAME hide
  $SCRIPT_NAME status
  $SCRIPT_NAME unhide
EOF
}

cmd_hide() {
	remove_exclude_blocks
	{
		echo "$BLOCK_BEGIN"
		printf '/%s\n' "${AI_PATHS[@]}"
		echo "$BLOCK_END"
	} >>"$EXCLUDE_FILE"
	log "Excluded untracked paths via $EXCLUDE_FILE"

	local file count=0
	while IFS= read -r -d '' file; do
		git update-index --skip-worktree --assume-unchanged -- "$file"
		debug "Hidden: $file"
		count=$((count + 1))
	done < <(list_tracked_paths)

	success "Hidden $count tracked file(s) from git status."
}

cmd_unhide() {
	remove_exclude_blocks
	log "Removed exclude block from $EXCLUDE_FILE"

	local file count=0
	while IFS= read -r -d '' file; do
		git update-index --no-skip-worktree --no-assume-unchanged -- "$file"
		debug "Restored: $file"
		count=$((count + 1))
	done < <(list_tracked_paths)

	success "Restored $count tracked file(s) to normal tracking."
}

cmd_status() {
	printf "${BOLD}Exclude block:${NC}\n"
	awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" '$0==b{p=1} p{print} $0==e{p=0}' "$EXCLUDE_FILE"
	printf "\n${BOLD}Hidden tracked files${NC} (S = skip-worktree, h = assume-unchanged):\n"
	git ls-files -v -- "${AI_PATHS[@]}" | grep -E '^[Sh]' || echo "(none)"
}

cmd_version() {
	printf "%s %s\n" "$SCRIPT_NAME" "$VERSION"
}

# ===================================
# ARGUMENT PARSING
# ===================================
parse_arguments() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-q | --quiet)
			QUIET=true
			shift
			;;
		-d | --debug)
			DEBUG=true
			shift
			;;
		-h | --help)
			cmd_help
			exit 0
			;;
		-v | --version)
			cmd_version
			exit 0
			;;
		-*)
			die "Unknown option: $1"
			;;
		*)
			shift
			;;
		esac
	done
}

# ===================================
# MAIN
# ===================================
main() {
	local command="${1:-help}"
	parse_arguments "$@"

	case "$command" in
	hide | unhide | status) setup_repository ;;
	esac

	case "$command" in
	hide) cmd_hide ;;
	unhide) cmd_unhide ;;
	status) cmd_status ;;
	help) cmd_help ;;
	version) cmd_version ;;
	*) die "Unknown command: '$command'. Use '$SCRIPT_NAME help'." ;;
	esac
}

main "$@"
