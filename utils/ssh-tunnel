#!/usr/bin/env bash
set -euo pipefail

# ===================================
# METADATA
# ===================================
SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly VERSION="1.0.0"

# ===================================
# COLORS
# ===================================
if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
	readonly RED=$'\033[0;31m'
	readonly GREEN=$'\033[0;32m'
	readonly YELLOW=$'\033[0;33m'
	readonly BLUE=$'\033[0;34m'
	readonly MAGENTA=$'\033[0;35m'
	readonly BOLD=$'\033[1m'
	readonly NC=$'\033[0m'
else
	readonly RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' BOLD='' NC=''
fi

# ===================================
# CONFIGURATION (DEFAULTS)
# ===================================
REMOTE=""
LOCAL_HOST="127.0.0.1"
LOCAL_PORT=""
TARGET_HOST="127.0.0.1"
TARGET_PORT=""
IPV4=true
FOREGROUND=false
QUIET=false
DEBUG=false
YES=false
COMMAND="menu"

readonly PID_DIR="${XDG_RUNTIME_DIR:-/tmp}"
PID_FILE=""

# ===================================
# LOGGING FUNCTIONS
# ===================================
log() {
	if [[ "$QUIET" != true ]]; then
		printf '%s▶%s %s\n' "$BLUE" "$NC" "$*"
	fi
}
warn() { printf "${YELLOW}⚠${NC} %s\n" "$*" >&2; }
error() { printf "${RED}✗${NC} %s\n" "$*" >&2; }
success() {
	if [[ "$QUIET" != true ]]; then
		printf '%s✓%s %s\n' "$GREEN" "$NC" "$*"
	fi
}
debug() {
	if [[ "$DEBUG" == true ]]; then
		printf '%s⚈%s DEBUG: %s\n' "$MAGENTA" "$NC" "$*" >&2
	fi
}
die() {
	error "$*"
	exit 1
}

# ===================================
# UTILITY FUNCTIONS
# ===================================
require_command() {
	if ! command -v "$1" >/dev/null 2>&1; then
		die "'$1' not found. Install it and re-run."
	fi
}

is_valid_port() {
	local p="$1"
	[[ "$p" =~ ^[0-9]+$ ]] || return 1
	((p >= 1 && p <= 65535))
}

sanitize_id() {
	printf '%s' "$1" | tr -c '[:alnum:]._-' '_'
}

confirm() {
	local prompt="$1"
	[[ "$YES" == true ]] && return 0
	read -r -p "$prompt [y/N]: " ans
	[[ "${ans:-}" == "y" || "${ans:-}" == "Y" ]]
}

pid_is_running() {
	local pid="$1"
	kill -0 "$pid" >/dev/null 2>&1
}

compute_pid_file() {
	local rid
	rid="$(sanitize_id "$REMOTE")"
	PID_FILE="${PID_DIR}/${SCRIPT_NAME}.${rid}.${LOCAL_HOST}.${LOCAL_PORT}-${TARGET_HOST}.${TARGET_PORT}.pid"
}

validate_config() {
	[[ -n "$REMOTE" ]] || die "Missing required option: --remote"
	[[ -n "$TARGET_PORT" ]] || die "Missing required option: --target-port"
	if [[ -z "$LOCAL_PORT" ]]; then
		LOCAL_PORT="$TARGET_PORT"
		debug "No --local-port provided; reusing --target-port ($TARGET_PORT)"
	fi
	is_valid_port "$LOCAL_PORT" || die "Invalid --local-port: $LOCAL_PORT"
	is_valid_port "$TARGET_PORT" || die "Invalid --target-port: $TARGET_PORT"
}

print_plan() {
	printf '\n%sTunnel Plan%s\n' "$BOLD" "$NC"
	printf "SSH host     : ${GREEN}%s${NC}\n" "$REMOTE"
	printf "Local bind   : ${GREEN}%s:%s${NC}\n" "$LOCAL_HOST" "$LOCAL_PORT"
	printf "Target       : ${GREEN}%s:%s${NC}\n" "$TARGET_HOST" "$TARGET_PORT"
	printf "Mode         : ${GREEN}%s${NC}\n" "$([[ "$FOREGROUND" == true ]] && echo "foreground" || echo "background")"
	printf "IP protocol  : ${GREEN}%s${NC}\n\n" "$([[ "$IPV4" == true ]] && echo "IPv4" || echo "default")"
}

ssh_tunnel_args() {
	local args=()
	[[ "$IPV4" == true ]] && args+=("-4")
	args+=(
		"-N"
		"-L" "${LOCAL_HOST}:${LOCAL_PORT}:${TARGET_HOST}:${TARGET_PORT}"
		"-o" "ExitOnForwardFailure=yes"
		"-o" "ServerAliveInterval=30"
		"-o" "ServerAliveCountMax=3"
		"-o" "TCPKeepAlive=yes"
		"-o" "BatchMode=yes"
		"$REMOTE"
	)
	printf '%s\n' "${args[@]}"
}

# ===================================
# COMMAND IMPLEMENTATIONS
# ===================================
cmd_open() {
	require_command ssh
	validate_config
	compute_pid_file

	if [[ -f "$PID_FILE" ]]; then
		local existing_pid
		existing_pid="$(<"$PID_FILE")"
		if pid_is_running "$existing_pid"; then
			die "Tunnel already running (pid=$existing_pid). Use '$SCRIPT_NAME close ...' first."
		fi
		warn "Removing stale pid file: $PID_FILE"
		rm -f "$PID_FILE"
	fi

	print_plan
	if ! confirm "Open SSH tunnel?"; then
		warn "Cancelled"
		exit 1
	fi

	local args=()
	while IFS= read -r arg; do
		args+=("$arg")
	done < <(ssh_tunnel_args)

	if [[ "$FOREGROUND" == true ]]; then
		log "Opening tunnel in foreground"
		exec ssh "${args[@]}"
	fi

	log "Opening tunnel in background"
	if ssh -f "${args[@]}"; then
		# Best-effort process capture for later close/status.
		local pid
		pid="$(pgrep -f "ssh .*${LOCAL_HOST}:${LOCAL_PORT}:${TARGET_HOST}:${TARGET_PORT} .*${REMOTE}" | head -n1 || true)"
		if [[ -n "$pid" ]]; then
			printf '%s\n' "$pid" >"$PID_FILE"
			debug "pid file written: $PID_FILE"
		fi
		success "Tunnel opened: ${LOCAL_HOST}:${LOCAL_PORT} -> ${TARGET_HOST}:${TARGET_PORT} via ${REMOTE}"
	else
		die "Failed to open tunnel"
	fi
}

cmd_close() {
	validate_config
	compute_pid_file

	if [[ ! -f "$PID_FILE" ]]; then
		warn "No pid file found: $PID_FILE"
		warn "If tunnel exists, close it manually or use: pkill -f '${LOCAL_HOST}:${LOCAL_PORT}:${TARGET_HOST}:${TARGET_PORT}'"
		exit 1
	fi

	local pid
	pid="$(<"$PID_FILE")"
	if ! pid_is_running "$pid"; then
		warn "Tunnel process not running (stale pid=$pid)."
		rm -f "$PID_FILE"
		exit 1
	fi

	if ! confirm "Close SSH tunnel (pid=$pid)?"; then
		warn "Cancelled"
		exit 1
	fi

	kill "$pid"
	rm -f "$PID_FILE"
	success "Tunnel closed"
}

cmd_status() {
	validate_config
	compute_pid_file

	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(<"$PID_FILE")"
		if pid_is_running "$pid"; then
			success "Tunnel is running (pid=$pid): ${LOCAL_HOST}:${LOCAL_PORT} -> ${TARGET_HOST}:${TARGET_PORT} via ${REMOTE}"
			return 0
		fi
		warn "Pid file exists but process is not running (stale pid=$pid)"
		return 1
	fi

	warn "Tunnel is not running"
	return 1
}

cmd_menu() {
	while true; do
		print_plan
		cat <<EOF2
Choose an action:
  1) Open tunnel (background)
  2) Open tunnel (foreground)
  3) Tunnel status
  4) Close tunnel
  5) Quit
EOF2
		echo
		read -r -p "Enter choice [1-5]: " choice

		case "${choice}" in
		1)
			FOREGROUND=false
			cmd_open
			;;
		2)
			FOREGROUND=true
			cmd_open
			;;
		3) cmd_status ;;
		4) cmd_close ;;
		5)
			log "Bye."
			exit 0
			;;
		*) die "Invalid choice: ${choice}" ;;
		esac
	done
}

# ===================================
# HELP & VERSION
# ===================================
cmd_help() {
	cat <<EOF
${BOLD}${SCRIPT_NAME}${NC} - Open/manage an SSH local tunnel with safe defaults

${BOLD}USAGE:${NC}
  $SCRIPT_NAME [OPTIONS] COMMAND

${BOLD}COMMANDS:${NC}
  ${GREEN}open${NC}       Open tunnel (default: background)
  ${GREEN}close${NC}      Close tunnel (using pid file)
  ${GREEN}status${NC}     Show tunnel status
  ${GREEN}menu${NC}       Interactive menu (default)
  ${GREEN}help${NC}       Show help
  ${GREEN}version${NC}    Show version

${BOLD}OPTIONS:${NC}
  ${YELLOW}-r, --remote${NC} HOST        SSH config alias or user@host (required)
  ${YELLOW}--local-host${NC} HOST        Local bind host (default: $LOCAL_HOST)
  ${YELLOW}--local-port${NC} PORT        Local bind port (default: same as --target-port)
  ${YELLOW}--target-host${NC} HOST       Target host from SSH server perspective (default: $TARGET_HOST)
  ${YELLOW}--target-port${NC} PORT       Target port from SSH server perspective (required)
  ${YELLOW}--foreground${NC}             Keep SSH process attached (no background)
  ${YELLOW}--no-ipv4${NC}                Do not force IPv4 (-4)
  ${YELLOW}-y, --yes${NC}                Skip confirmations
  ${YELLOW}-q, --quiet${NC}              Less output
  ${YELLOW}-d, --debug${NC}              Debug output
  ${YELLOW}-h, --help${NC}               Show help
  ${YELLOW}-v, --version${NC}            Show version

${BOLD}EQUIVALENT FORMAT:${NC}
  ssh -4 -N -L <local_host>:<local_port>:<target_host>:<target_port> <remote>

${BOLD}EXAMPLES:${NC}
  $SCRIPT_NAME -r vps --local-port 1433 --target-port 1433 open
  $SCRIPT_NAME -r vps --local-port 15433 --target-port 1433 open
  $SCRIPT_NAME -r user@203.0.113.10 --target-host db.internal --target-port 5432 open
  $SCRIPT_NAME -r vps status
EOF
}

cmd_version() {
	printf "%s %s\n" "$SCRIPT_NAME" "$VERSION"
}

# ===================================
# ARGUMENT PARSING
# ===================================
parse_arguments() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-r | --remote)
			REMOTE="${2:?Missing argument for $1}"
			shift 2
			;;
		--local-host)
			LOCAL_HOST="${2:?Missing argument for $1}"
			shift 2
			;;
		--local-port)
			LOCAL_PORT="${2:?Missing argument for $1}"
			shift 2
			;;
		--target-host)
			TARGET_HOST="${2:?Missing argument for $1}"
			shift 2
			;;
		--target-port)
			TARGET_PORT="${2:?Missing argument for $1}"
			shift 2
			;;
		--foreground)
			FOREGROUND=true
			shift
			;;
		--no-ipv4)
			IPV4=false
			shift
			;;
		-y | --yes)
			YES=true
			shift
			;;
		-q | --quiet)
			QUIET=true
			shift
			;;
		-d | --debug)
			DEBUG=true
			shift
			;;
		-h | --help)
			cmd_help
			exit 0
			;;
		-v | --version)
			cmd_version
			exit 0
			;;
		-*)
			die "Unknown option: $1"
			;;
		*)
			if [[ "$COMMAND" == "menu" ]]; then
				COMMAND="$1"
			fi
			shift
			;;
		esac
	done
}

# ===================================
# MAIN FUNCTION
# ===================================
main() {
	parse_arguments "$@"

	case "$COMMAND" in
	open) cmd_open ;;
	close) cmd_close ;;
	status) cmd_status ;;
	menu) cmd_menu ;;
	help) cmd_help ;;
	version) cmd_version ;;
	*) die "Unknown command: '$COMMAND'. Use '$SCRIPT_NAME help' for usage information." ;;
	esac
}

# ===================================
# ENTRY POINT
# ===================================
main "$@"
